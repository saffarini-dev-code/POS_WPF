<Window x:Class="POS_WPF.Presentation.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise Retail POS"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="ENTERPRISE RETAIL POS"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text=".NET 10 • WPF"
                           Foreground="#9CA3AF"
                           FontSize="14"
                           Margin="16,5,0,0"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="#F3F4F6">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="POS foundation ready"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#111827"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Domain, inventory units, transactional integrity, localization and printing boundaries are being built first."
                           Margin="0,14,0,0"
                           FontSize="16"
                           Foreground="#4B5563"
                           TextAlignment="Center"
                           MaxWidth="760" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
