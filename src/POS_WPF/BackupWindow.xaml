<Window x:Class="POS_WPF.BackupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Backup & Restore" Width="700" Height="420" WindowStartupLocation="CenterScreen">
<Grid Margin="24"><StackPanel><TextBlock Text="Database Backup & Restore" FontSize="28" FontWeight="Bold"/><TextBlock Text="Stop all active transactions before restoring a database." Foreground="#B91C1C" Margin="0,6,0,24"/><StackPanel Orientation="Horizontal"><Button Content="Backup" Width="130" Height="42" Click="Backup_Click"/><Button Content="Restore" Width="130" Height="42" Margin="10,0" Click="Restore_Click"/></StackPanel><TextBlock x:Name="StatusText" Margin="0,20" TextWrapping="Wrap" Foreground="#6B7280"/></StackPanel></Grid></Window>
