<UserControl x:Class="POS_WPF.InventoryManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,16"><StackPanel><TextBlock Text="Inventory Management" FontSize="27" FontWeight="Bold"/><TextBlock Text="Stock balances, adjustments and warehouse control" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><ComboBox x:Name="WarehouseBox" Width="260" DockPanel.Dock="Right" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Warehouse_Changed"/></DockPanel><Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14"><DataGrid x:Name="StockGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Stock_Selected"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180"/><DataGridTextColumn Header="Base Unit" Binding="{Binding Unit}" Width="100"/><DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid></Border><Border Grid.Row="2" Background="#111827" CornerRadius="14" Padding="16" Margin="0,16,0,0"><WrapPanel VerticalAlignment="Center"><TextBlock Text="Selected" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="SelectedProductText" Text="None" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0"/><TextBox x:Name="QuantityBox" Width="110" Text="1"/><ComboBox x:Name="DirectionBox" Width="125" Margin="8,0" SelectedIndex="0"><ComboBoxItem Content="Increase"/><ComboBoxItem Content="Decrease"/></ComboBox><TextBox x:Name="ReasonBox" Width="260" Margin="0,0,8,0"/><Button Content="✓  Apply Adjustment" Background="#2563EB" Foreground="White" BorderThickness="0" Click="Adjust_Click"/><TextBlock x:Name="StatusText" Foreground="#A7F3D0" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/></WrapPanel></Border></Grid></UserControl>