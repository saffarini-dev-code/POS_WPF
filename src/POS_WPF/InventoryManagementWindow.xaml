<UserControl x:Class="POS_WPF.InventoryManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,16"><StackPanel><TextBlock Text="Inventory" FontSize="27" FontWeight="Bold"/><TextBlock Text="Stock balances, adjustments and warehouse control" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right"><TextBlock Text="Warehouse" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/><ComboBox x:Name="WarehouseBox" Width="260" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Warehouse_Changed"/></StackPanel></DockPanel>
<Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14"><DataGrid x:Name="StockGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Stock_Selected"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180"/><DataGridTextColumn Header="Base Unit" Binding="{Binding Unit}" Width="100"/><DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid></Border>
<Border Grid.Row="2" Background="#111827" CornerRadius="14" Padding="16" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Selected Product" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="SelectedProductText" Text="None" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Quantity" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="QuantityBox" Text="1" Margin="0,5,0,0"/></StackPanel>
<StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Direction" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/><ComboBox x:Name="DirectionBox" SelectedIndex="0" Margin="0,5,0,0"><ComboBoxItem Content="Increase"/><ComboBoxItem Content="Decrease"/></ComboBox></StackPanel>
<StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="Reason" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="ReasonBox" Margin="0,5,0,0"/></StackPanel>
<Button Grid.Column="4" Content="✓  Apply Adjustment" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="16,9" VerticalAlignment="Bottom" Click="Adjust_Click" Margin="0,0,12,0"/>
<StackPanel Grid.Column="5" VerticalAlignment="Bottom"><TextBlock Text="Status" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="#A7F3D0" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
</Grid></Border></Grid></UserControl>