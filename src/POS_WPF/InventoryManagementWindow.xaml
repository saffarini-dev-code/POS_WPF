<Window x:Class="POS_WPF.InventoryManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Inventory Management" Width="1250" Height="760" WindowStartupLocation="CenterScreen">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,16"><StackPanel><TextBlock Text="Inventory Management" FontSize="27" FontWeight="Bold"/><TextBlock Text="Stock balances, adjustments and warehouse control" Foreground="#6B7280"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="WarehouseBox" Width="260" Height="38" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Warehouse_Changed"/></StackPanel></DockPanel><Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14"><DataGrid x:Name="StockGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Stock_Selected"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180"/><DataGridTextColumn Header="Base Unit" Binding="{Binding Unit}" Width="100"/><DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid></Border><Border Grid.Row="2" Background="#111827" CornerRadius="12" Padding="16" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Selected:" Foreground="#9CA3AF" VerticalAlignment="Center"/><TextBlock x:Name="SelectedProductText" Text="None" Foreground="White" FontWeight="SemiBold" Margin="8,0,24,0" VerticalAlignment="Center"/><TextBox x:Name="QuantityBox" Width="120" Height="38" Padding="8" Text="1"/><ComboBox x:Name="DirectionBox" Width="130" Height="38" Margin="8,0" SelectedIndex="0"><ComboBoxItem Content="Increase"/><ComboBoxItem Content="Decrease"/></ComboBox><TextBox x:Name="ReasonBox" Width="260" Height="38" Padding="8" Margin="8,0"/><Button Content="Apply Adjustment" Width="150" Height="38" Margin="8,0" Click="Adjust_Click"/><TextBlock x:Name="StatusText" Foreground="#A7F3D0" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid></Window>