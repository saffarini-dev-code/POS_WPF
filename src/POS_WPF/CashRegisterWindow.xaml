<Window x:Class="POS_WPF.CashRegisterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cash Register" Width="760" Height="560" WindowStartupLocation="CenterScreen">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Cash Register" FontSize="28" FontWeight="Bold"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18"><TextBlock Text="Opening Balance" VerticalAlignment="Center"/><TextBox x:Name="OpeningBox" Width="140" Height="38" Margin="10,0" Padding="8"/><Button Content="Open" Width="90" Height="38" Click="Open_Click"/><Button Content="Refresh" Width="90" Height="38" Margin="8,0" Click="Refresh_Click"/></StackPanel>
<Border Grid.Row="2" Background="White" Padding="20"><StackPanel><TextBlock x:Name="StatusText" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Expected Cash" Foreground="#6B7280" Margin="0,20,0,2"/><TextBlock x:Name="ExpectedText" FontSize="30" FontWeight="Bold"/><TextBlock Text="Actual Cash" Foreground="#6B7280" Margin="0,18,0,2"/><TextBox x:Name="ActualBox" Height="38" Padding="8"/><TextBlock Text="Variance" Foreground="#6B7280" Margin="0,18,0,2"/><TextBlock x:Name="VarianceText" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16"><Button Content="Calculate" Width="120" Height="42" Click="Calculate_Click"/><Button Content="Close Register" Width="140" Height="42" Margin="8,0" Click="Close_Click"/></StackPanel></Grid></Window>
