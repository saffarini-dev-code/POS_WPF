<UserControl x:Class="POS_WPF.CategoryManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="14" Padding="24" Margin="0,0,18,0"><StackPanel>
<TextBlock Text="Category Management" FontSize="26" FontWeight="Bold"/><TextBlock Text="Create, edit and organize product categories" Foreground="#64748B" Margin="0,4,0,26"/>
<TextBlock Text="Category Name" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Margin="0,6,0,16"/>
<TextBlock Text="Arabic Name" FontWeight="SemiBold"/><TextBox x:Name="ArabicNameBox" Margin="0,6,0,16"/>
<TextBlock Text="Parent Category" FontWeight="SemiBold"/><ComboBox x:Name="ParentBox" Margin="0,6,0,22" DisplayMemberPath="Name" SelectedValuePath="Id"/>
<WrapPanel><Button Content="＋  New" Click="New_Click"/><Button Content="✓  Save" Background="#2563EB" Foreground="White" BorderThickness="0" Click="Save_Click"/><Button Content="⛔  Deactivate" Foreground="#DC2626" Click="Deactivate_Click"/><Button Content="🗑  Delete" Foreground="#B91C1C" Click="Delete_Click"/></WrapPanel>
<TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#64748B" Margin="0,18,0,0"/>
</StackPanel></Border>
<Border Grid.Column="1" Background="White" CornerRadius="14" Padding="18"><DockPanel>
<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14"><TextBox x:Name="SearchBox" Width="300" MinHeight="40" TextChanged="Search_Changed"/><Button Content="↻  Refresh" Margin="10,0,0,0" Click="Refresh_Click"/></StackPanel>
<DataGrid x:Name="CategoriesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Category_Selected"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Arabic" Binding="{Binding NameArabic}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/></DataGrid.Columns></DataGrid>
</DockPanel></Border></Grid></UserControl>