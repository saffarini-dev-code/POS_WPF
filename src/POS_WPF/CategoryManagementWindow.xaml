<Window x:Class="POS_WPF.CategoryManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Category Management" Width="1000" Height="650" WindowStartupLocation="CenterScreen">
<Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,18,0"><StackPanel><TextBlock Text="Category Management" FontSize="25" FontWeight="Bold"/><TextBlock Text="Create and organize product categories" Foreground="#6B7280" Margin="0,4,0,24"/><TextBlock Text="Name" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Height="38" Margin="0,6,0,14"/><TextBlock Text="Arabic Name" FontWeight="SemiBold"/><TextBox x:Name="ArabicNameBox" Height="38" Margin="0,6,0,14"/><TextBlock Text="Parent Category" FontWeight="SemiBold"/><ComboBox x:Name="ParentBox" Height="38" Margin="0,6,0,18" DisplayMemberPath="Name" SelectedValuePath="Id"/><StackPanel Orientation="Horizontal"><Button Content="New" Width="85" Click="New_Click"/><Button Content="Save" Width="85" Margin="8,0" Click="Save_Click"/><Button Content="Deactivate" Width="100" Click="Deactivate_Click"/></StackPanel><TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#6B7280" Margin="0,18,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBox x:Name="SearchBox" Height="38" Padding="10" TextChanged="Search_Changed"/><Button Content="Refresh" Width="90" HorizontalAlignment="Right" Margin="0,8,0,12" Click="Refresh_Click"/></StackPanel><DataGrid x:Name="CategoriesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Category_Selected"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Arabic" Binding="{Binding NameArabic}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/></DataGrid.Columns></DataGrid></DockPanel></Border></Grid></Window>