<Window x:Class="POS_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retail POS"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" Padding="24,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="RETAIL POS" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right" Text="Offline Ready" Foreground="#A7F3D0" FontSize="14" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="POS" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Barcode / product search" Margin="0,8,0,20" Foreground="#6B7280" />
                    <TextBox Height="44" FontSize="18" />
                    <TextBlock Text="Cart is ready for the product and unit-aware checkout workflow." Margin="0,24,0,0" Foreground="#6B7280" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#111827" CornerRadius="12" Padding="24" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="TOTAL" Foreground="#9CA3AF" FontSize="14" />
                    <TextBlock Text="0.00" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,8,0,24" />
                    <Button Content="PAYMENT" Height="52" FontSize="16" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
