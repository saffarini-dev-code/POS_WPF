<Window x:Class="POS_WPF.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Enterprise Retail POS" Width="1440" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight">
<Window.Resources>
    <Style TargetType="Button">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
</Window.Resources>
<Grid Background="#F3F4F6">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#111827" Padding="18">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="RETAIL POS" Foreground="White" FontSize="21" FontWeight="Bold" Margin="4,8,4,28"/>
                <Button Content="Dashboard" HorizontalContentAlignment="Left"/>
                <Button Content="Point of Sale" HorizontalContentAlignment="Left" Click="OpenPos_Click"/>
                <Button Content="Products" HorizontalContentAlignment="Left" Click="OpenProducts_Click"/>
                <Button Content="Inventory / Opening Stock" HorizontalContentAlignment="Left" Click="OpenOpeningStock_Click"/>
                <Button Content="Purchasing" HorizontalContentAlignment="Left"/>
                <Button Content="Sales" HorizontalContentAlignment="Left"/>
                <Button Content="Customers" HorizontalContentAlignment="Left" Click="OpenCustomers_Click"/>
                <Button Content="Suppliers" HorizontalContentAlignment="Left" Click="OpenSuppliers_Click"/>
                <Button Content="Cash Register" HorizontalContentAlignment="Left" Click="OpenCashRegister_Click"/>
                <Button Content="Reports" HorizontalContentAlignment="Left" Click="OpenReports_Click"/>
                <Button Content="Settings" HorizontalContentAlignment="Left" Click="OpenSettings_Click"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <Separator Margin="0,16"/>
                <TextBlock Text="Offline Ready" Foreground="#A7F3D0" Margin="4,0,4,6"/>
                <TextBlock Text="v0.2 Operational Foundation" Foreground="#9CA3AF" Margin="4,0,4,8"/>
            </StackPanel>
        </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Dashboard" FontSize="30" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Enterprise Retail Operations" Foreground="#6B7280" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Branch: Main" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Authenticated Session" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24">
            <Border Background="White" CornerRadius="10" Margin="0,0,8,0" Padding="18"><StackPanel><TextBlock Text="Today's Sales" Foreground="#6B7280"/><TextBlock Text="0.00" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Background="White" CornerRadius="10" Margin="8,0" Padding="18"><StackPanel><TextBlock Text="Transactions" Foreground="#6B7280"/><TextBlock Text="0" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Background="White" CornerRadius="10" Margin="8,0" Padding="18"><StackPanel><TextBlock Text="Low Stock" Foreground="#6B7280"/><TextBlock Text="0" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Background="White" CornerRadius="10" Margin="8,0,0,0" Padding="18"><StackPanel><TextBlock Text="Open Register" Foreground="#6B7280"/><TextBlock Text="Ready" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="22" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="20" FontWeight="SemiBold"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Content="New Sale" Margin="0,0,8,8" Height="55" Click="OpenPos_Click"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="Products" Margin="8,0,0,8" Height="55" Click="OpenProducts_Click"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="Opening Stock" Margin="0,8,8,0" Height="55" Click="OpenOpeningStock_Click"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Reports" Margin="8,8,0,0" Height="55" Click="OpenReports_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#111827" CornerRadius="10" Padding="22" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="System Status" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Local database" Foreground="#9CA3AF" Margin="0,18,0,0"/>
                    <TextBlock Text="Ready" Foreground="#A7F3D0" FontWeight="SemiBold" Margin="0,4,0,12"/>
                    <TextBlock Text="Atomic sales posting" Foreground="#9CA3AF"/>
                    <TextBlock Text="Enabled" Foreground="#A7F3D0" FontWeight="SemiBold" Margin="0,4,0,12"/>
                    <TextBlock Text="Offline queue" Foreground="#9CA3AF"/>
                    <TextBlock Text="Ready" Foreground="#A7F3D0" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Grid>
</Window>