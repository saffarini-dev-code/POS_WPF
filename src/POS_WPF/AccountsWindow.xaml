<Window x:Class="POS_WPF.AccountsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Customers &amp; Suppliers" Width="1200" Height="760" WindowStartupLocation="CenterScreen">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><ComboBox x:Name="PartyTypeBox" Width="150" Height="38" SelectionChanged="PartyType_Changed"><ComboBoxItem Content="Customers"/><ComboBoxItem Content="Suppliers"/></ComboBox><TextBox x:Name="CodeBox" Width="140" Height="38" Margin="8,0" Padding="8"/><TextBox x:Name="NameBox" Width="240" Height="38" Padding="8"/><TextBox x:Name="CreditBox" Width="120" Height="38" Margin="8,0" Padding="8"/><Button Content="Save" Width="100" Height="38" Click="Save_Click"/><Button Content="Refresh" Width="100" Height="38" Margin="8,0" Click="Refresh_Click"/></StackPanel>
<Grid Grid.Row="1" Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions><DataGrid x:Name="PartyGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="Party_Selected"/><Border Grid.Column="1" Background="White" Padding="16" Margin="12,0,0,0"><StackPanel><TextBlock Text="Account Statement" FontSize="22" FontWeight="Bold"/><DataGrid x:Name="StatementGrid" AutoGenerateColumns="True" IsReadOnly="True" Height="360" Margin="0,14"/><StackPanel Orientation="Horizontal"><TextBox x:Name="PaymentBox" Width="150" Height="38" Padding="8"/><Button Content="Post Payment" Width="120" Height="38" Margin="8,0" Click="Payment_Click"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#6B7280"/></StackPanel></StackPanel></Border></Grid></Grid></Window>