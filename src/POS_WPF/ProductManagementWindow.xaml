<Window x:Class="POS_WPF.ProductManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Products &amp; Units" Width="1450" Height="820" WindowStartupLocation="CenterScreen">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Button Content="New Product" Width="120" Height="38" Click="New_Click"/><TextBox x:Name="SearchBox" Width="320" Height="38" Margin="12,0,0,0" Padding="10" TextChanged="Search_Changed"/><Button Content="Refresh" Width="100" Height="38" Margin="8,0" Click="Refresh_Click"/><Button Content="Save Product" Width="130" Height="38" Margin="8,0" Click="Save_Click"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="2.2*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="White" Padding="10" Margin="0,0,10,0"><DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Product_Selected"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120"/></DataGrid.Columns></DataGrid></Border>
<Border Grid.Column="1" Background="White" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Product Information" FontSize="24" FontWeight="Bold" Margin="0,0,0,14"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="SKU" Grid.Row="0" Margin="0,0,10,4"/><TextBlock Text="Category" Grid.Row="0" Grid.Column="1" Margin="10,0,0,4"/>
<TextBox x:Name="SkuBox" Grid.Row="1" Height="36" Padding="8" Margin="0,0,10,8"/><ComboBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="1" Height="36" Margin="10,0,0,8" DisplayMemberPath="Name" SelectedValuePath="Id"/>
<TextBlock Text="Name" Grid.Row="2" Margin="0,0,10,4"/><TextBlock Text="Arabic Name" Grid.Row="2" Grid.Column="1" Margin="10,0,0,4"/>
<TextBox x:Name="NameBox" Grid.Row="3" Height="36" Padding="8" Margin="0,0,10,8"/><TextBox x:Name="ArabicNameBox" Grid.Row="3" Grid.Column="1" Height="36" Padding="8" Margin="10,0,0,8"/>
</Grid>
<Border Background="#F3F4F6" CornerRadius="8" Padding="12" Margin="0,8,0,16"><StackPanel><TextBlock Text="Current Stock" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="CurrentStockText" Text="0" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="StockUnitText" Text=" PCS" FontSize="14" VerticalAlignment="Bottom" Margin="5,0,0,4" Foreground="#6B7280"/></StackPanel><TextBlock Text="Stock is calculated from inventory transactions in the active warehouse." FontSize="11" Foreground="#6B7280"/></StackPanel></Border>
<TextBlock Text="Units, Conversion &amp; Pricing" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
<DataGrid x:Name="UnitsGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="300"><DataGrid.Columns><DataGridTextColumn Header="Unit" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="100"/><DataGridTextColumn Header="Abbr." Binding="{Binding Abbreviation, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="Factor" Binding="{Binding ConversionFactorToBase, UpdateSourceTrigger=PropertyChanged}" Width="70"/><DataGridTextColumn Header="Barcode" Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="120"/><DataGridTextColumn Header="Cost" Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" Width="85"/><DataGridTextColumn Header="Retail" Binding="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" Width="85"/><DataGridTextColumn Header="Wholesale" Binding="{Binding WholesalePrice, UpdateSourceTrigger=PropertyChanged}" Width="95"/><DataGridTextColumn Header="Wholesale+" Binding="{Binding WholesaleWholesalePrice, UpdateSourceTrigger=PropertyChanged}" Width="105"/><DataGridCheckBoxColumn Header="Sell" Binding="{Binding CanSell}" Width="55"/><DataGridCheckBoxColumn Header="Buy" Binding="{Binding CanPurchase}" Width="55"/><DataGridCheckBoxColumn Header="Base" Binding="{Binding IsBaseUnit}" Width="55"/></DataGrid.Columns></DataGrid>
<Button Content="Add Unit" Width="110" Height="38" Margin="0,10,0,0" Click="AddUnit_Click"/>
<TextBlock x:Name="StatusText" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel></ScrollViewer></Border></Grid>
</Grid></Window>
