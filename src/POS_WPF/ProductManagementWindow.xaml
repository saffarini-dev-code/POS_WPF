<Window x:Class="POS_WPF.ProductManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Products &amp; Units" Width="1250" Height="760" WindowStartupLocation="CenterScreen">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Margin="0,0,0,14"><TextBox x:Name="SearchBox" Width="320" Height="38" Padding="10" TextChanged="Search_Changed"/><Button Content="Refresh" Width="100" Height="38" Margin="8,0" Click="Refresh_Click"/><Button Content="Save Product" Width="130" Height="38" Margin="8,0" Click="Save_Click"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.9*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="White" Padding="10" Margin="0,0,10,0"><DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Product_Selected"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Arabic" Binding="{Binding NameArabic}" Width="*"/></DataGrid.Columns></DataGrid></Border>
<Border Grid.Column="1" Background="White" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Product" FontSize="24" FontWeight="Bold"/><TextBlock Text="SKU" Margin="0,18,0,4"/><TextBox x:Name="SkuBox" Height="36" Padding="8"/><TextBlock Text="Name" Margin="0,10,0,4"/><TextBox x:Name="NameBox" Height="36" Padding="8"/><TextBlock Text="Arabic Name" Margin="0,10,0,4"/><TextBox x:Name="ArabicNameBox" Height="36" Padding="8"/><TextBlock Text="Category ID (optional)" Margin="0,10,0,4"/><TextBox x:Name="CategoryBox" Height="36" Padding="8"/>
<TextBlock Text="Units" FontSize="20" FontWeight="SemiBold" Margin="0,22,0,8"/><DataGrid x:Name="UnitsGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="230"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Abbr." Binding="{Binding Abbreviation, UpdateSourceTrigger=PropertyChanged}" Width="70"/><DataGridTextColumn Header="Factor" Binding="{Binding ConversionFactorToBase, UpdateSourceTrigger=PropertyChanged}" Width="80"/><DataGridTextColumn Header="Barcode" Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="120"/><DataGridTextColumn Header="Sell Price" Binding="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" Width="90"/><DataGridCheckBoxColumn Header="Sell" Binding="{Binding CanSell}" Width="55"/><DataGridCheckBoxColumn Header="Buy" Binding="{Binding CanPurchase}" Width="55"/><DataGridCheckBoxColumn Header="Base" Binding="{Binding IsBaseUnit}" Width="55"/></DataGrid.Columns></DataGrid><Button Content="Add Unit" Width="110" Height="38" Margin="0,10,0,0" Click="AddUnit_Click"/><TextBlock x:Name="StatusText" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border></Grid>
</Grid></Window>