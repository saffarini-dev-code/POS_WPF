<UserControl x:Class="POS_WPF.ProductManagementWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="＋  New Product" Click="New_Click"/>
            <TextBox x:Name="SearchBox" Width="320" Margin="4,0,8,0" TextChanged="Search_Changed" ToolTip="Search by SKU, product or category"/>
            <Button Content="↻  Refresh" Click="Refresh_Click"/>
            <Button Content="✓  Save Product" Background="#2563EB" Foreground="White" BorderThickness="0" Click="Save_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="2.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="10" Margin="0,0,14,0">
                <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Product_Selected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Product Information" FontSize="24" FontWeight="Bold" Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="SKU" Grid.Row="0" Margin="0,0,10,5"/>
                            <TextBlock Text="Category" Grid.Row="0" Grid.Column="1" Margin="10,0,0,5"/>
                            <TextBox x:Name="SkuBox" Grid.Row="1" Margin="0,0,10,12"/>
                            <ComboBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="1" Margin="10,0,0,12" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                            <TextBlock Text="Name" Grid.Row="2" Margin="0,0,10,5"/>
                            <TextBlock Text="Arabic Name" Grid.Row="2" Grid.Column="1" Margin="10,0,0,5"/>
                            <TextBox x:Name="NameBox" Grid.Row="3" Margin="0,0,10,12"/>
                            <TextBox x:Name="ArabicNameBox" Grid.Row="3" Grid.Column="1" Margin="10,0,0,12" FlowDirection="RightToLeft"/>
                        </Grid>

                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Opening Stock"/>
                                <TextBox x:Name="OpeningStockBox" Text="0" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Warehouse"/>
                                <ComboBox x:Name="WarehouseBox" Margin="0,6,0,0" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Current Stock" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CurrentStockText" Text="0" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="StockUnitText" Text=" PCS" Foreground="#64748B" VerticalAlignment="Bottom" Margin="5,0,0,4"/>
                                </StackPanel>
                                <TextBlock Text="Calculated from inventory transactions." FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Units, Conversion &amp; Pricing" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="Define every selling/purchasing unit for this product. The Base unit must have factor 1. Example: PCS = 1, Carton = 10 means 1 Carton = 10 PCS." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <DataGrid x:Name="UnitsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="220" MaxHeight="340" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                                    <DataGridTextColumn Header="Abbr." Binding="{Binding Abbreviation,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="Factor → Base" Binding="{Binding ConversionFactorToBase,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                    <DataGridTextColumn Header="Cost" Binding="{Binding PurchasePrice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                    <DataGridTextColumn Header="Retail" Binding="{Binding SellingPrice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                    <DataGridTextColumn Header="Wholesale" Binding="{Binding WholesalePrice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                    <DataGridTextColumn Header="Wholesale+" Binding="{Binding WholesaleWholesalePrice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                                    <DataGridCheckBoxColumn Header="Sell" Binding="{Binding CanSell,Mode=TwoWay}" Width="52"/>
                                    <DataGridCheckBoxColumn Header="Buy" Binding="{Binding CanPurchase,Mode=TwoWay}" Width="52"/>
                                    <DataGridCheckBoxColumn Header="Base" Binding="{Binding IsBaseUnit,Mode=TwoWay}" Width="52"/>
                                    <DataGridTemplateColumn Header="" Width="48">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="×" Foreground="#DC2626" BorderThickness="0" Background="Transparent" Padding="4" ToolTip="Remove unit" Click="RemoveUnit_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="＋  Add Unit" Width="120" Click="AddUnit_Click"/>
                            <TextBlock Text="Use a different Unit name for each row — e.g. PCS, Box, Carton." VerticalAlignment="Center" Foreground="#64748B" FontSize="11" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusText" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>