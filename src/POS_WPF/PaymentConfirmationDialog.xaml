<Window x:Class="POS_WPF.PaymentConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="400"
        Height="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Width="400" Height="400"
            Background="White"
            CornerRadius="12"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Padding="24"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="PROCESSING PAYMENT" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalText" FontSize="21" Foreground="#172033" Margin="0,3,0,0"/>
                </StackPanel>
                <Border x:Name="PaymentMethodBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EAF7EE" CornerRadius="6" Padding="10,6">
                    <TextBlock x:Name="PaymentMethodText" FontSize="10" Foreground="#16A34A" FontWeight="Bold"/>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="#E2E8F0" Margin="0,16,0,0"/>
            <Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="Amount due" FontSize="13" Foreground="#64748B"/><TextBlock x:Name="AmountDueText" HorizontalAlignment="Right" FontSize="16" Foreground="#172033" FontWeight="SemiBold"/></Grid>
            <Border Grid.Row="3" Background="#E2E8F0" Margin="0,14,0,0"/>
            <Grid Grid.Row="4" Margin="0,14,0,0"><TextBlock Text="Cash received" FontSize="13" Foreground="#64748B"/><TextBlock x:Name="CashReceivedText" HorizontalAlignment="Right" FontSize="16" Foreground="#172033" FontWeight="SemiBold"/></Grid>
            <Border Grid.Row="5" Background="#E2E8F0" Margin="0,14,0,0"/>
            <Grid Grid.Row="6" Margin="0,14,0,0"><TextBlock Text="Change" FontSize="15" Foreground="#16A34A" FontWeight="SemiBold"/><TextBlock x:Name="ChangeText" HorizontalAlignment="Right" FontSize="21" Foreground="#16A34A" FontWeight="Bold"/></Grid>
            <Grid Grid.Row="8" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Grid.Column="0" Content="Cancel" Height="44" Margin="0,0,5,0" Click="Cancel_Click" Background="White" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="13" FontWeight="SemiBold"/>
                <Button x:Name="CompleteButton" Grid.Column="1" Content="Complete Sale" Height="44" Margin="5,0,0,0" Click="CompleteSale_Click" Background="#20A64A" Foreground="White" BorderBrush="#20A64A" BorderThickness="1" FontSize="13" FontWeight="Bold"/>
            </Grid>
        </Grid>
    </Border>
</Window>
