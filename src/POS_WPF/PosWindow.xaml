<Window x:Class="POS_WPF.PosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Point of Sale" Width="1400" Height="850" WindowStartupLocation="CenterScreen">
<Grid Background="#F3F4F6" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="POS" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/><TextBox x:Name="BarcodeBox" Width="420" Height="42" Margin="30,0,8,0" Padding="12" KeyDown="Barcode_KeyDown"/><Button Content="Scan / Add" Width="130" Height="42" Click="Add_Click"/></StackPanel>
<Border Grid.Row="1" Background="White" Padding="12" CornerRadius="10"><DataGrid x:Name="CartGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="100"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="90"/><DataGridTextColumn Header="Factor" Binding="{Binding ConversionFactor}" Width="90"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice}" Width="110"/><DataGridTextColumn Header="Discount" Binding="{Binding Discount}" Width="110"/><DataGridTextColumn Header="Tax" Binding="{Binding Tax}" Width="100"/><DataGridTextColumn Header="Total" Binding="{Binding LineTotal}" Width="120"/></DataGrid.Columns></DataGrid></Border>
<Border Grid.Row="2" Background="White" Padding="18" Margin="0,14,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Width="520"><TextBlock Text="Total" FontSize="18"/><TextBlock x:Name="TotalText" Text="0.00" FontSize="34" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Paid" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="PaymentBox" Width="130" Height="40" Padding="10" Text="0.00"/><Button Content="Complete Sale" Width="140" Height="40" Margin="8,0" Click="Complete_Click"/><Button Content="Print Receipt" Width="110" Height="40" Click="PrintLast_Click"/></StackPanel></StackPanel><TextBlock x:Name="StatusText" Text="Ready for barcode scan" VerticalAlignment="Center" Foreground="#6B7280" TextWrapping="Wrap"/></DockPanel></Border>
</Grid></Window>
