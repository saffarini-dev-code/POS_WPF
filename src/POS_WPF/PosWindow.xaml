<Window x:Class="POS_WPF.PosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA POS"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#EEF1F5"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="TopButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="CategoryButton" TargetType="Button"><Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#D8DEE8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#334155"/><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="ProductButton" TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E0E5EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PaymentButton" TargetType="Button"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#DCE2EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#334155"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="26" Height="26" Background="#20A64A" CornerRadius="5" VerticalAlignment="Center"><TextBlock Text="▦" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="NOVA POS" Margin="9,0,0,0" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/><Border Grid.Column="2" Width="1" Height="18" Background="#E2E8F0" HorizontalAlignment="Left" Margin="14,0,0,0"/><TextBlock Grid.Column="2" Text="Register #3" Margin="27,0,0,0" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/><TextBlock Grid.Column="3" x:Name="ClockText" Text="Sat, Aug 22 01:45:02 AM" Margin="0,0,28,0" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/><StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="28" Height="28" Background="#F1F5F9" CornerRadius="14"><TextBlock Text="JM" Foreground="#64748B" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="8,0,0,0"><TextBlock Text="Jamie Morales" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="Cashier · Shift A" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right"/></StackPanel></StackPanel></Grid></Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="12,10,0,0"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="5" Margin="0,0,14,0"><Grid><TextBlock Text="⌕" FontSize="19" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="BarcodeBox" BorderThickness="0" Background="Transparent" Margin="35,0,8,0" FontSize="13" VerticalContentAlignment="Center" KeyDown="Barcode_KeyDown" ToolTip="Search products or scan barcode"/></Grid></Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,7,0,0"><StackPanel Orientation="Horizontal"><Button Content="All" Style="{StaticResource CategoryButton}" Background="#20A64A" Foreground="White" BorderBrush="#20A64A"/><Button Content="Food &amp; Bev" Style="{StaticResource CategoryButton}"/><Button Content="Snacks" Style="{StaticResource CategoryButton}"/><Button Content="Electronics" Style="{StaticResource CategoryButton}"/><Button Content="Clothing" Style="{StaticResource CategoryButton}"/><Button Content="Home" Style="{StaticResource CategoryButton}"/><Button Content="Beauty" Style="{StaticResource CategoryButton}"/></StackPanel></ScrollViewer>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" Margin="0,10,0,0"><ItemsControl x:Name="PopularProductsPanel"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ProductButton}" Height="86" Click="PopularProduct_Click"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding SkuText}" FontSize="9" Foreground="#94A3B8"/><TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Grid Grid.Row="2"><TextBlock Text="{Binding PriceText}" FontSize="15" Foreground="#16A34A" FontWeight="Bold"/><TextBlock Text="{Binding SoldText}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </Grid>
            <Border Grid.Column="1" Background="#F7F8FA" BorderBrush="#DCE2EA" BorderThickness="1,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><Grid Margin="12,0"><TextBlock Text="▣  THERMAL · 80mm" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="LIVE PREVIEW" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Border Width="238" MinHeight="680" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="12,18,12,18" Padding="12,20"><StackPanel FontFamily="Consolas"><TextBlock Text="NOVA POS" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="1420 Market St, Suite 200" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="San Francisco, CA 94102" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/><TextBlock Text="Tel: (415) 555-0192" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/><Separator Margin="0,10"/><Grid FontSize="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DATE"/><TextBlock Text="CASHIER"/><TextBlock Text="REG"/><TextBlock Text="TXN"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="ReceiptDateText" Text="08/22/26 01:45 AM"/><TextBlock Text="JAMIE M."/><TextBlock Text="#3 · SHIFT A"/><TextBlock x:Name="ReceiptOrderText" Text="TXN-5LUWAM"/></StackPanel></Grid><Separator Margin="0,8"/><Grid FontSize="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Text="ITEM"/><TextBlock Grid.Column="1" Text="QTY" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="AMT" HorizontalAlignment="Right"/></Grid><ItemsControl x:Name="ReceiptItemsPanel" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="25"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ProductName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UnitName}" FontSize="7" Foreground="#94A3B8"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Quantity,StringFormat=N0}" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding LineTotal,StringFormat=N2}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Margin="0,8"/><Grid FontSize="8"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="SUBTOTAL"/><TextBlock x:Name="ReceiptSubtotalText" Grid.Column="1" Text="0.00" HorizontalAlignment="Right"/><TextBlock Grid.Row="1" Text="DISCOUNT" Margin="0,4,0,0"/><TextBlock x:Name="ReceiptDiscountText" Grid.Row="1" Grid.Column="1" Text="0.00" HorizontalAlignment="Right" Margin="0,4,0,0"/><TextBlock Grid.Row="2" Text="TAX" Margin="0,4,0,0"/><TextBlock x:Name="ReceiptTaxText" Grid.Row="2" Grid.Column="1" Text="0.00" HorizontalAlignment="Right" Margin="0,4,0,0"/></Grid><Border BorderBrush="#0F172A" BorderThickness="0,1,0,0" Margin="0,8,0,6"/><Grid FontSize="10" FontWeight="Bold"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="TOTAL"/><TextBlock x:Name="ReceiptTotalText" Grid.Column="1" Text="0.00" HorizontalAlignment="Right"/></Grid><Separator Margin="0,8"/><Grid FontSize="8"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="PAYMENT"/><TextBlock x:Name="ReceiptPaymentText" Grid.Column="1" Text="CARD" HorizontalAlignment="Right"/><TextBlock Grid.Row="1" Text="TENDERED" Margin="0,4,0,0"/><TextBlock x:Name="ReceiptTenderedText" Grid.Row="1" Grid.Column="1" Text="0.00" HorizontalAlignment="Right" Margin="0,4,0,0"/><TextBlock Grid.Row="2" Text="CHANGE" Margin="0,4,0,0"/><TextBlock x:Name="ReceiptChangeText" Grid.Row="2" Grid.Column="1" Text="0.00" HorizontalAlignment="Right" Margin="0,4,0,0"/></Grid><TextBlock x:Name="ReceiptItemsCountText" Text="0 ITEMS · 0 LINES" FontSize="8" HorizontalAlignment="Center" Margin="0,13,0,0"/><TextBlock Text="||||||||||||||||||||||" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock x:Name="ReceiptFooterText" Text="Thank you for shopping!" FontSize="8" HorizontalAlignment="Center" Margin="0,5,0,0"/><TextBlock Text="Returns within 14 days with original receipt." FontSize="7" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel></Border></ScrollViewer></Grid></Border>
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="1,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="120"/><RowDefinition Height="176"/><RowDefinition Height="32"/></Grid.RowDefinitions><Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><Grid Margin="14,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="ORDER" FontSize="10" Foreground="#94A3B8"/><TextBlock x:Name="OrderNumberText" Text="TXN-5LUWAM" FontSize="14" FontWeight="Bold"/></StackPanel><Button Content="VOID" Style="{StaticResource TopButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearCart_Click"/></Grid></Border><Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"><DataGrid x:Name="CartGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="None" GridLinesVisibility="None" RowHeight="58" SelectionUnit="FullRow" Background="White" BorderThickness="0"><DataGrid.Columns><DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="14,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding UnitName}" FontSize="9" Foreground="#94A3B8"/></StackPanel><Button Grid.Column="1" Content="−" Width="24" Height="22" Padding="0" Margin="6,0,3,0" Tag="{Binding}" Click="DecreaseQuantity_Click"/><TextBlock Grid.Column="2" Text="{Binding Quantity,StringFormat=N0}" Width="25" TextAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="3" Content="+" Width="24" Height="22" Padding="0" Margin="3,0,6,0" Tag="{Binding}" Click="IncreaseQuantity_Click"/><TextBlock Grid.Column="4" Text="{Binding LineTotal,StringFormat=N2}" Width="55" TextAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border><StackPanel Grid.Row="2" Margin="14,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CouponBox" Height="32" Text="COUPON CODE" Foreground="#94A3B8" BorderBrush="#E2E8F0" Padding="10,5" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="APPLY" Height="32" Margin="7,0,0,0" Padding="13,4" Foreground="#EAB676" BorderBrush="#F5D7A7" Background="#FFFFFF"/></Grid><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Subtotal" Foreground="#94A3B8" FontSize="11"/><TextBlock x:Name="SubtotalText" Grid.Column="1" Text="0.00" FontSize="11"/><TextBlock Grid.Row="1" Text="Discount" Foreground="#94A3B8" FontSize="11" Margin="0,5,0,0"/><TextBlock x:Name="DiscountText" Grid.Row="1" Grid.Column="1" Text="0.00" FontSize="11" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Text="Total" FontSize="14" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock x:Name="TotalText" Grid.Row="2" Grid.Column="1" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#16A34A" Margin="0,9,0,0"/></Grid></StackPanel><StackPanel Grid.Row="3" Margin="14,0"><TextBlock Text="PAYMENT METHOD" FontSize="9" Foreground="#94A3B8"/><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="CardButton" Content="▣ Card" Style="{StaticResource PaymentButton}" Click="PaymentMethod_Click" Tag="Card"/><Button x:Name="CashButton" Grid.Column="1" Content="▣ Cash" Style="{StaticResource PaymentButton}" Click="PaymentMethod_Click" Tag="Cash"/><Button x:Name="MobileButton" Grid.Column="2" Content="▣ Mobile" Style="{StaticResource PaymentButton}" Click="PaymentMethod_Click" Tag="Mobile"/></Grid><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="Tendered" Foreground="#94A3B8" FontSize="10"/><TextBox x:Name="PaymentBox" Grid.Column="1" Text="0.00" Height="34" TextAlignment="Right" Padding="8,5"/></Grid><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Invoice discount" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center"/><TextBox x:Name="InvoiceDiscountBox" Text="0.00" Width="70" Height="28" Margin="8,0,5,0" Padding="6,3"/><Button Content="Apply" Height="28" Padding="8,3" Click="ApplyInvoiceDiscount_Click"/></StackPanel><Button Content="CHARGE" Height="42" Margin="0,10,0,0" Background="#20A64A" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="Complete_Click"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Hold Order" Height="28" Width="120" Click="Hold_Click"/><Button Content="Recall" Height="28" Width="100" Margin="6,0,0,0" Click="Recall_Click"/><TextBox x:Name="HoldLabelBox" Width="110" Height="28" Margin="6,0,0,0" ToolTip="Optional hold label"/></StackPanel><ComboBox x:Name="HeldOrdersBox" Visibility="Collapsed" DisplayMemberPath="Display" SelectedValuePath="Id"/><ComboBox x:Name="PaymentMethodBox" Visibility="Collapsed" SelectedIndex="0"><ComboBoxItem Content="Cash"/><ComboBoxItem Content="Card"/><ComboBoxItem Content="Mobile"/></ComboBox></StackPanel><Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0"><TextBlock Text="F1 Help · F2 Hold · F4 Discount · F8 Void · F10 Charge" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="0,1,0,0"><Grid Margin="18,0"><TextBlock Text="ITEMS:" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center"/><TextBlock x:Name="FooterItemsText" Text="0" FontSize="9" Foreground="#16A34A" Margin="45,0,0,0" VerticalAlignment="Center"/><TextBlock Text="LINES:" FontSize="9" Foreground="#94A3B8" Margin="80,0,0,0" VerticalAlignment="Center"/><TextBlock x:Name="FooterLinesText" Text="0" FontSize="9" Foreground="#16A34A" Margin="120,0,0,0" VerticalAlignment="Center"/><TextBlock Text="SUBTOTAL:" FontSize="9" Foreground="#94A3B8" Margin="165,0,0,0" VerticalAlignment="Center"/><TextBlock x:Name="FooterSubtotalText" Text="0.00" FontSize="9" Foreground="#16A34A" Margin="225,0,0,0" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Ready for barcode scan" FontSize="9" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
</Window>