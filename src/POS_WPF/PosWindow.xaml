<UserControl x:Class="POS_WPF.PosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.Column="0" Grid.Row="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,14,12"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="⌕  Scan / Add" Padding="18,8" Click="Add_Click"/><TextBox x:Name="BarcodeBox" Width="360" Margin="10,0,0,0" KeyDown="Barcode_KeyDown"/></StackPanel><StackPanel><TextBlock Text="Point of Sale" FontSize="24" FontWeight="Bold"/><TextBlock Text="Scan barcode or select a product to add it to the cart" Foreground="#64748B" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
<Border Grid.Column="0" Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,14,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Best Selling Products" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Quick add — ranked from completed sales" Foreground="#64748B" FontSize="11" Margin="0,2,0,12"/></StackPanel><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PopularProductsPanel"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="205" Height="98" Margin="0,0,10,10" Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" Click="PopularProduct_Click"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PriceText}" Foreground="#16A34A" FontSize="19" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="{Binding SoldText}" Foreground="#64748B" FontSize="11"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
<Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="White" CornerRadius="14" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,12"><StackPanel><TextBlock Text="CURRENT ORDER" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/><TextBlock x:Name="OrderNumberText" Text="New Sale" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="HeldOrdersBox" Width="150" DisplayMemberPath="Display" SelectedValuePath="Id"/><Button Content="⏸  Hold" Padding="10,7" Margin="6,0,0,0" Click="Hold_Click"/><Button Content="↻  Recall" Padding="10,7" Margin="6,0,0,0" Click="Recall_Click"/></StackPanel></DockPanel>
<DataGrid x:Name="CartGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" SelectionUnit="FullRow" CellEditEnding="Cart_CellEditEnding"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" IsReadOnly="True" Width="65"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="60"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice}" IsReadOnly="True" Width="75"/><DataGridTextColumn Header="Discount" Binding="{Binding ManualDiscount,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80"/><DataGridTextColumn Header="Promo" Binding="{Binding PromotionDiscount}" IsReadOnly="True" Width="70"/><DataGridTextColumn Header="Total" Binding="{Binding LineTotal}" IsReadOnly="True" Width="85"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Invoice Discount" FontSize="11" Foreground="#64748B"/><TextBlock Text="Manual discount for the whole invoice" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/></StackPanel><TextBox x:Name="InvoiceDiscountBox" Grid.Column="1" Text="0.00" Margin="8,0"/><Button Grid.Column="2" Content="Apply" Padding="10,6" Click="ApplyInvoiceDiscount_Click"/></Grid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="⌫  Void Line" Click="VoidLine_Click"/><Button Content="✕  Clear Cart" Margin="6,0,0,0" Click="ClearCart_Click"/><TextBox x:Name="HoldLabelBox" Width="140" Margin="6,0,0,0" ToolTip="Optional hold label"/></StackPanel></StackPanel>
<Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0"><StackPanel><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="Subtotal" Foreground="#64748B"/><TextBlock x:Name="SubtotalText" Grid.Column="1" Text="0.00" HorizontalAlignment="Right"/></Grid><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="Discount" Foreground="#64748B"/><TextBlock x:Name="DiscountText" Grid.Column="1" Text="0.00" HorizontalAlignment="Right"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="TOTAL" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="TotalText" Grid.Column="1" Text="0.00" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="#16A34A"/></Grid></StackPanel></Border>
<StackPanel Grid.Row="4" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Payment Method" FontSize="11" Foreground="#64748B"/><ComboBox x:Name="PaymentMethodBox" Margin="0,4,8,0" SelectedIndex="0"><ComboBoxItem Content="Cash"/><ComboBoxItem Content="Card"/><ComboBoxItem Content="Mobile"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Paid" FontSize="11" Foreground="#64748B"/><TextBox x:Name="PaymentBox" Text="0.00" Margin="0,4,8,0"/></StackPanel><Button Grid.Column="2" Content="✓  CHARGE" Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="Complete_Click"/></Grid><TextBlock x:Name="StatusText" Text="Ready for barcode scan" Foreground="#64748B" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
</Grid></Border></Grid></UserControl>