<UserControl x:Class="POS_WPF.PosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,14"><DockPanel><Button Content="⌕  Scan / Add" DockPanel.Dock="Right" Padding="18,0" Click="Add_Click"/><TextBox x:Name="BarcodeBox" Width="420" HorizontalAlignment="Right" Margin="0,0,10,0" KeyDown="Barcode_KeyDown"/><StackPanel><TextBlock Text="Point of Sale" FontSize="22" FontWeight="Bold"/><TextBlock Text="Scan barcode or choose a best-selling product" Foreground="#64748B" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel></Border><Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Best Selling Products" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Quick add — ranked from completed sales" Foreground="#64748B" FontSize="11" Margin="0,2,0,10"/></StackPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="PopularProductsPanel"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="190" Height="92" Margin="0,0,10,0" Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" Click="PopularProduct_Click"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PriceText}" Foreground="#2563EB" FontSize="18" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="{Binding SoldText}" Foreground="#64748B" FontSize="11"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border><Border Grid.Row="2" Background="White" Padding="12" CornerRadius="14"><DataGrid x:Name="CartGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="100"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="90"/><DataGridTextColumn Header="Factor" Binding="{Binding ConversionFactor}" Width="90"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice}" Width="110"/><DataGridTextColumn Header="Discount" Binding="{Binding Discount}" Width="110"/><DataGridTextColumn Header="Tax" Binding="{Binding Tax}" Width="100"/><DataGridTextColumn Header="Total" Binding="{Binding LineTotal}" Width="120"/></DataGrid.Columns></DataGrid></Border><Border Grid.Row="3" Background="White" Padding="16" Margin="0,14,0,0" CornerRadius="14"><DockPanel><StackPanel DockPanel.Dock="Right" Width="430"><StackPanel Orientation="Horizontal"><TextBlock Text="Total" FontSize="16" Foreground="#64748B"/><TextBlock x:Name="TotalText" Text="0.00" FontSize="30" FontWeight="Bold" Margin="14,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Paid" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="PaymentBox" Width="130" Text="0.00"/><Button Content="✓  Complete Sale" Background="#2563EB" Foreground="White" BorderThickness="0" Click="Complete_Click"/><Button Content="▣  Print" Click="PrintLast_Click"/></StackPanel></StackPanel><TextBlock x:Name="StatusText" Text="Ready for barcode scan" VerticalAlignment="Center" Foreground="#64748B" TextWrapping="Wrap"/></DockPanel></Border></Grid></UserControl>