<Window x:Class="POS_WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retail POS - Login" Width="480" Height="520" MinHeight="520" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F3F4F6" FlowDirection="LeftToRight">
        <Border Background="White" Margin="28" Padding="32" CornerRadius="14">
            <StackPanel>
                <TextBlock Text="RETAIL POS" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Secure sign in" Foreground="#6B7280" Margin="0,4,0,28"/>
                <TextBlock Text="Username" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameBox" Height="40" Margin="0,6,0,16" Padding="10"/>
                <TextBlock Text="Password" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,6,0,10" Padding="10"/>
                <TextBlock x:Name="ErrorText" Foreground="#B91C1C" TextWrapping="Wrap" MinHeight="30"/>
                <Button x:Name="LoginButton" Content="Sign In" Height="46" Margin="0,10,0,0" Click="LoginButton_Click" IsDefault="True"/>
                <TextBlock Text="First run: admin / ChangeMe123! (must be changed after sign in)" Foreground="#9CA3AF" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
