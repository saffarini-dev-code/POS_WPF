<Window x:Class="POS_WPF.StoreManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Store Management" Width="1050" Height="700" WindowStartupLocation="CenterScreen">
<Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="12" Padding="22" Margin="0,0,18,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Store Management" FontSize="26" FontWeight="Bold"/><TextBlock Text="Store identity, contact details, currency and branding" Foreground="#6B7280" Margin="0,4,0,24"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Store Name"/><TextBox x:Name="StoreNameBox" Height="38" Margin="0,6,0,14"/><TextBlock Text="Arabic Store Name"/><TextBox x:Name="ArabicNameBox" Height="38" Margin="0,6,0,14"/><TextBlock Text="Currency"/><ComboBox x:Name="CurrencyBox" Height="38" Margin="0,6,0,14" DisplayMemberPath="Display" SelectedValuePath="Code"/><TextBlock Text="Country"/><TextBox x:Name="CountryBox" Height="38" Margin="0,6,0,14"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="City"/><TextBox x:Name="CityBox" Height="38" Margin="0,6,0,14"/><TextBlock Text="Phone"/><TextBox x:Name="PhoneBox" Height="38" Margin="0,6,0,14"/><TextBlock Text="Mobile"/><TextBox x:Name="MobileBox" Height="38" Margin="0,6,0,14"/><TextBlock Text="Email"/><TextBox x:Name="EmailBox" Height="38" Margin="0,6,0,14"/><TextBlock Text="Website"/><TextBox x:Name="WebsiteBox" Height="38" Margin="0,6,0,14"/></StackPanel></Grid><TextBlock Text="Address"/><TextBox x:Name="AddressBox" Height="70" Margin="0,6,0,14" TextWrapping="Wrap" AcceptsReturn="True"/><StackPanel Orientation="Horizontal"><Button Content="Choose Store Logo" Width="150" Height="42" Click="Logo_Click"/><Button Content="Save Store" Width="130" Height="42" Margin="10,0" Click="Save_Click"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#6B7280" TextWrapping="Wrap"/></StackPanel></StackPanel></ScrollViewer></Border><Border Grid.Column="1" Background="#111827" CornerRadius="12" Padding="22"><StackPanel><TextBlock Text="Store Logo" Foreground="White" FontSize="20" FontWeight="SemiBold"/><Border Background="White" Height="180" Margin="0,18" CornerRadius="8"><Image x:Name="LogoImage" Stretch="Uniform" Margin="12"/></Border><TextBlock x:Name="LogoPathText" Text="No logo selected" Foreground="#9CA3AF" TextWrapping="Wrap"/><Separator Margin="0,20"/><TextBlock Text="Current Branch" Foreground="#9CA3AF"/><TextBlock x:Name="BranchText" Text="Main" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,6"/><TextBlock Text="Store settings are applied to the active branch." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></Grid></Window>