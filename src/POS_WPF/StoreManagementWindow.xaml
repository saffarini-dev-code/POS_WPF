<UserControl x:Class="POS_WPF.StoreManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="14" Padding="26" Margin="0,0,18,0"><StackPanel><TextBlock Text="Store Management" FontSize="26" FontWeight="Bold"/><TextBlock Text="Store identity, contact details, currency and branding" Foreground="#64748B" Margin="0,4,0,26"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Store Name"/><TextBox x:Name="StoreNameBox" Margin="0,6,0,16"/><TextBlock Text="Arabic Store Name"/><TextBox x:Name="ArabicNameBox" Margin="0,6,0,16"/><TextBlock Text="Currency"/><ComboBox x:Name="CurrencyBox" Margin="0,6,0,16" DisplayMemberPath="Display" SelectedValuePath="Code"/><TextBlock Text="Country"/><TextBox x:Name="CountryBox" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="City"/><TextBox x:Name="CityBox" Margin="0,6,0,16"/><TextBlock Text="Phone"/><TextBox x:Name="PhoneBox" Margin="0,6,0,16"/><TextBlock Text="Mobile"/><TextBox x:Name="MobileBox" Margin="0,6,0,16"/><TextBlock Text="Email"/><TextBox x:Name="EmailBox" Margin="0,6,0,16"/><TextBlock Text="Website"/><TextBox x:Name="WebsiteBox" Margin="0,6,0,0"/></StackPanel></Grid><TextBlock Text="Address" Margin="0,22,0,0"/><TextBox x:Name="AddressBox" Margin="0,6,0,18" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/><StackPanel Orientation="Horizontal"><Button Content="▣  Choose Logo" Click="Logo_Click"/><Button Content="✓  Save Store" Background="#2563EB" Foreground="White" BorderThickness="0" Click="Save_Click"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel></StackPanel></Border><Border Grid.Column="1" Background="#111827" CornerRadius="14" Padding="22"><StackPanel><TextBlock Text="Store Branding" Foreground="White" FontSize="20" FontWeight="SemiBold"/><Border Background="White" Height="200" Margin="0,18" CornerRadius="10"><Image x:Name="LogoImage" Stretch="Uniform" Margin="14"/></Border><TextBlock x:Name="LogoPathText" Text="No logo selected" Foreground="#94A3B8" TextWrapping="Wrap"/><Separator Margin="0,20"/><TextBlock Text="Current Branch" Foreground="#94A3B8"/><TextBlock x:Name="BranchText" Text="Main" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,6"/><TextBlock Text="Settings are applied to the active branch." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></Grid></ScrollViewer></UserControl>