<Window x:Class="POS_WPF.ManagerAuthorizationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Manager Authorization" Width="460" Height="330" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
<Grid Margin="24"><StackPanel><TextBlock Text="Manager Authorization" FontSize="24" FontWeight="Bold"/><TextBlock Text="This operation requires elevated permission." Foreground="#6B7280" Margin="0,5,0,20"/><TextBlock Text="Username"/><TextBox x:Name="UsernameBox" Height="38" Margin="0,5,0,12" Padding="8"/><TextBlock Text="Password"/><PasswordBox x:Name="PasswordBox" Height="38" Margin="0,5,0,8" Padding="8"/><TextBlock x:Name="ErrorText" Foreground="#B91C1C" MinHeight="25"/><Button Content="Authorize" Height="42" Click="Authorize_Click"/></StackPanel></Grid></Window>
