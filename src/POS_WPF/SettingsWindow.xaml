<Window x:Class="POS_WPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Store Settings"
        Width="900"
        Height="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="TaxSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Background="#CBD5E1" CornerRadius="14"/>
                            <Ellipse x:Name="Thumb" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#20A64A"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,3,3,3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Store Settings" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Configure store identity, currency, language, tax and branding."
                       Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Store Name" Grid.Row="0" VerticalAlignment="Center"/>
            <TextBox x:Name="StoreNameBox" Grid.Row="0" Grid.Column="1" Height="38" Padding="8"/>

            <TextBlock Text="Arabic Name" Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <TextBox x:Name="ArabicNameBox" Grid.Row="1" Grid.Column="1" Height="38" Padding="8" Margin="0,12,0,0"/>

            <TextBlock Text="Currency" Grid.Row="2" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <ComboBox x:Name="CurrencyBox" Grid.Row="2" Grid.Column="1" Height="38" Margin="0,12,0,0"
                      DisplayMemberPath="Display" SelectedValuePath="Code"/>

            <TextBlock Text="Language" Grid.Row="3" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <ComboBox x:Name="LanguageBox" Grid.Row="3" Grid.Column="1" Height="38" Margin="0,12,0,0">
                <ComboBoxItem Content="English"/>
                <ComboBoxItem Content="العربية"/>
            </ComboBox>

            <TextBlock Text="Tax Rate %" Grid.Row="4" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <TextBox x:Name="TaxRateBox" Grid.Row="4" Grid.Column="1" Height="38" Padding="8" Margin="0,12,0,0"/>

            <TextBlock Text="Show Tax" Grid.Row="5" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                <CheckBox x:Name="TaxEnabledBox" Style="{StaticResource TaxSwitchStyle}" IsChecked="False"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Enable tax in cashier" FontWeight="SemiBold"/>
                    <TextBlock Text="When enabled, tax is calculated and printed on invoices."
                               Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Store Logo" Grid.Row="6" VerticalAlignment="Top" Margin="0,18,0,0"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,18,0,0">
                <Border Width="90" Height="70" Background="#F3F4F6" CornerRadius="8">
                    <Image x:Name="LogoPreview" Stretch="Uniform" Margin="8"/>
                </Border>
                <StackPanel Margin="14,0,0,0">
                    <Button Content="Choose Logo" Width="130" Height="36" Click="ChooseLogo_Click"/>
                    <TextBlock x:Name="LogoPathText" Foreground="#6B7280" FontSize="11" Margin="0,7,0,0"
                               TextWrapping="Wrap" MaxWidth="500"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#6B7280" Margin="0,0,18,0"/>
            <Button Content="Save" Width="120" Height="42" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
