<Window x:Class="POS_WPF.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="800" Height="620" WindowStartupLocation="CenterScreen">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Store Settings" FontSize="28" FontWeight="Bold"/><Grid Grid.Row="1" Margin="0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Store Name" Grid.Row="0" VerticalAlignment="Center"/><TextBox x:Name="StoreNameBox" Grid.Row="0" Grid.Column="1" Height="38" Padding="8"/><TextBlock Text="Arabic Name" Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0"/><TextBox x:Name="ArabicNameBox" Grid.Row="1" Grid.Column="1" Height="38" Padding="8" Margin="0,12,0,0"/><TextBlock Text="Currency" Grid.Row="2" VerticalAlignment="Center" Margin="0,12,0,0"/><TextBox x:Name="CurrencyBox" Grid.Row="2" Grid.Column="1" Height="38" Padding="8" Margin="0,12,0,0"/><TextBlock Text="Language" Grid.Row="3" VerticalAlignment="Center" Margin="0,12,0,0"/><ComboBox x:Name="LanguageBox" Grid.Row="3" Grid.Column="1" Height="38" Margin="0,12,0,0"><ComboBoxItem Content="English"/><ComboBoxItem Content="العربية"/></ComboBox><TextBlock Text="Tax Rate %" Grid.Row="4" VerticalAlignment="Center" Margin="0,12,0,0"/><TextBox x:Name="TaxRateBox" Grid.Row="4" Grid.Column="1" Height="38" Padding="8" Margin="0,12,0,0"/></Grid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#6B7280" Margin="0,0,18,0"/><Button Content="Save" Width="120" Height="42" Click="Save_Click"/></StackPanel></Grid></Window>
