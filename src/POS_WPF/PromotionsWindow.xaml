<UserControl x:Class="POS_WPF.PromotionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="14" Padding="22" Margin="0,0,16,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Promotions" FontSize="26" FontWeight="Bold"/><TextBlock Text="Create scheduled offers and quantity deals" Foreground="#64748B" Margin="0,4,0,22"/>
<TextBlock Text="Promotion Code" FontWeight="SemiBold"/><TextBox x:Name="CodeBox" Margin="0,6,0,12"/>
<TextBlock Text="Promotion Name" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Margin="0,6,0,12"/>
<TextBlock Text="Product" FontWeight="SemiBold"/><ComboBox x:Name="ProductBox" Margin="0,6,0,12" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="Product_Changed"/>
<TextBlock Text="Unit" FontWeight="SemiBold"/><ComboBox x:Name="UnitBox" Margin="0,6,0,12" DisplayMemberPath="Display" SelectedValuePath="Id"/>
<TextBlock Text="Promotion Type" FontWeight="SemiBold"/><ComboBox x:Name="TypeBox" Margin="0,6,0,12" SelectedIndex="0"><ComboBoxItem Content="Percentage discount"/><ComboBoxItem Content="Fixed amount discount"/><ComboBoxItem Content="Buy X Get Y"/><ComboBoxItem Content="Quantity deal — X for total price"/></ComboBox>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,12"><TextBlock Text="Value" FontWeight="SemiBold"/><TextBox x:Name="ValueBox" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Minimum Quantity" FontWeight="SemiBold"/><TextBox x:Name="MinimumQuantityBox" Text="1" Margin="0,6,0,0"/></StackPanel></Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,12"><TextBlock Text="Reward Quantity" FontWeight="SemiBold"/><TextBox x:Name="RewardQuantityBox" Text="0" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Max Promo Quantity" FontWeight="SemiBold"/><TextBox x:Name="MaxQuantityBox" Text="" Margin="0,6,0,0"/></StackPanel></Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,12"><TextBlock Text="Starts" FontWeight="SemiBold"/><DatePicker x:Name="StartDateBox" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Ends (optional)" FontWeight="SemiBold"/><DatePicker x:Name="EndDateBox" Margin="0,6,0,0"/></StackPanel></Grid>
<WrapPanel><Button Content="＋  New" Click="New_Click"/><Button Content="✓  Save" Background="#2563EB" Foreground="White" BorderThickness="0" Click="Save_Click"/><Button Content="⛔  Deactivate" Foreground="#DC2626" Click="Deactivate_Click"/></WrapPanel><TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></ScrollViewer></Border>
<Border Grid.Column="1" Background="White" CornerRadius="14" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14"><TextBox x:Name="SearchBox" Width="300" MinHeight="40" TextChanged="Search_Changed"/><Button Content="↻  Refresh" Margin="10,0,0,0" Click="Refresh_Click"/></StackPanel><DataGrid x:Name="PromotionsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Promotion_Selected"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="180"/><DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="170"/><DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="180"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></DockPanel></Border>
</Grid></UserControl>