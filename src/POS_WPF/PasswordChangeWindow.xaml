<Window x:Class="POS_WPF.PasswordChangeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Retail POS — Change Password" WindowStartupLocation="CenterScreen" WindowState="Maximized"><Grid Background="#F5F7FB"><Border Background="#111827" CornerRadius="0" Width="420" Padding="34" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel><Border Width="48" Height="48" Background="#2563EB" CornerRadius="12" HorizontalAlignment="Left"><TextBlock Text="✓" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Change Password" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,22,0,0"/><TextBlock Text="Your initial password must be changed before continuing." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,6,0,28"/><TextBlock Text="New Password" Foreground="#E2E8F0" FontWeight="SemiBold"/><PasswordBox x:Name="NewPassword" Margin="0,7,0,16"/><TextBlock Text="Confirm Password" Foreground="#E2E8F0" FontWeight="SemiBold"/><PasswordBox x:Name="ConfirmPassword" Margin="0,7,0,10"/><TextBlock x:Name="ErrorText" Foreground="#FCA5A5" MinHeight="28" TextWrapping="Wrap"/><Button Content="✓  Save Password" Height="46" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,6,0,0" Click="Save_Click"/></StackPanel></Border></Grid></Window>