<Window x:Class="POS_WPF.PasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Width="460" Height="440" MinHeight="440" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F3F4F6">
        <Border Background="White" Margin="28" Padding="28" CornerRadius="14">
            <StackPanel>
                <TextBlock Text="Change Password" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Your initial password must be changed before continuing." Foreground="#6B7280" Margin="0,5,0,22"/>
                <TextBlock Text="New Password" FontWeight="SemiBold"/>
                <PasswordBox x:Name="NewPassword" Height="40" Margin="0,6,0,14" Padding="10"/>
                <TextBlock Text="Confirm Password" FontWeight="SemiBold"/>
                <PasswordBox x:Name="ConfirmPassword" Height="40" Margin="0,6,0,8" Padding="10"/>
                <TextBlock x:Name="ErrorText" Foreground="#B91C1C" MinHeight="28" TextWrapping="Wrap"/>
                <Button Content="Save Password" Height="44" Margin="0,4,0,0" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
