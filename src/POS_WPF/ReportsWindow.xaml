<Window x:Class="POS_WPF.ReportsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reports" Width="1250" Height="760" WindowStartupLocation="CenterScreen">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="From" VerticalAlignment="Center"/><DatePicker x:Name="FromDate" Margin="8,0,16,0"/><TextBlock Text="To" VerticalAlignment="Center"/><DatePicker x:Name="ToDate" Margin="8,0,16,0"/><Button Content="Sales Report" Width="120" Height="36" Click="Sales_Click"/><Button Content="Inventory Report" Width="130" Height="36" Margin="8,0" Click="Inventory_Click"/><Button Content="Export CSV" Width="110" Height="36" Click="Export_Click"/></StackPanel>
<TabControl Grid.Row="1" Margin="0,18"><TabItem Header="Sales"><DataGrid x:Name="SalesGrid" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem><TabItem Header="Inventory"><DataGrid x:Name="InventoryGrid" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem></TabControl></Grid></Window>
